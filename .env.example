# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NÃO deve ser enviado para o GitHub.

# --- Flask ---
FLASK_DEBUG=1
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria-com-32-ou-mais-caracteres
SESSION_COOKIE_SECURE=0

# --- Banco SQLite ---
# O arquivo e as tabelas são criados automaticamente na primeira execução.
DB_PATH=instance/morphpeetron.db
SEED_DEMO=1

# --- Servidor local ---
HOST=127.0.0.1
PORT=5000
AUTO_OPEN_BROWSER=1

# --- API (JWT) ---
JWT_EXPIRA_HORAS=8
